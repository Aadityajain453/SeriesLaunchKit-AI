# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/serieslaunchkit

# ---------- Auth ----------
# Use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
# lax for same-site deployments; use "none" (requires HTTPS) when frontend and API are on different domains
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---------- Credits ----------
SIGNUP_CREDITS=100
COST_SERIES_GENERATION=5
COST_EPISODE_SCRIPT=2
COST_PROMPT_ENHANCE=1
COST_VIDEO_GENERATION=10

# ---------- Anthropic Claude (text generation) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---------- Text-to-video provider ----------
# Supported: kie  (leave VIDEO_PROVIDER empty to disable video generation)
VIDEO_PROVIDER=kie
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_VIDEO_MODEL=veo3_fast
